# Copy to backend/.env and fill in. Never commit the real file.
DB_URL=jdbc:postgresql://localhost:5432/studyvault
DB_USER=studyvault
DB_PASSWORD=change-me
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRY_HOURS=12
# Optional: leave empty and the rest of the app still works; AI chat will say it is not configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
STORAGE_DIR=./data/files
MAX_FILE_MB=25
STORAGE_QUOTA_MB=1024
CORS_ORIGINS=http://localhost:5173
# Set to true when served over HTTPS
COOKIE_SECURE=false
